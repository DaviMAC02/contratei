# Database
DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email Server (Resend via Nodemailer)
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER="resend"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Stripe (same key supports both BRL and USD)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# Stripe Price IDs (create these in Stripe Dashboard)
# Starter Plan
STRIPE_STARTER_MONTHLY_BRL_PRICE_ID="price_xxx"
STRIPE_STARTER_YEARLY_BRL_PRICE_ID="price_xxx"
STRIPE_STARTER_MONTHLY_USD_PRICE_ID="price_xxx"
STRIPE_STARTER_YEARLY_USD_PRICE_ID="price_xxx"

# Growth Plan
STRIPE_GROWTH_MONTHLY_BRL_PRICE_ID="price_xxx"
STRIPE_GROWTH_YEARLY_BRL_PRICE_ID="price_xxx"
STRIPE_GROWTH_MONTHLY_USD_PRICE_ID="price_xxx"
STRIPE_GROWTH_YEARLY_USD_PRICE_ID="price_xxx"

# Pro Plan
STRIPE_PRO_MONTHLY_BRL_PRICE_ID="price_xxx"
STRIPE_PRO_YEARLY_BRL_PRICE_ID="price_xxx"
STRIPE_PRO_MONTHLY_USD_PRICE_ID="price_xxx"
STRIPE_PRO_YEARLY_USD_PRICE_ID="price_xxx"

# Studio Plan
STRIPE_STUDIO_MONTHLY_BRL_PRICE_ID="price_xxx"
STRIPE_STUDIO_YEARLY_BRL_PRICE_ID="price_xxx"
STRIPE_STUDIO_MONTHLY_USD_PRICE_ID="price_xxx"
STRIPE_STUDIO_YEARLY_USD_PRICE_ID="price_xxx"

# Resend
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="noreply@yourapp.com"

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Contratei"

# Cron Secret (for securing cron endpoints)
CRON_SECRET="your-cron-secret-here-generate-random-string"

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
