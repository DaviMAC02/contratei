# Database (any PostgreSQL works; `docker compose up -d` starts one locally)
DATABASE_URL="postgresql://contratei:contratei@localhost:5432/contratei"
DIRECT_URL="postgresql://contratei:contratei@localhost:5432/contratei"

# Auth.js (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google sign-in (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email via Resend: magic-link sign-in and contract alerts
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Protects /api/cron/daily (generate with: openssl rand -hex 32)
CRON_SECRET=""
