{
  "buildCommand": "pnpm run build",
  "functions": {
    "src/app/api/**": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "regions": ["gru1"],
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 2 * * *"
    }
  ]
}